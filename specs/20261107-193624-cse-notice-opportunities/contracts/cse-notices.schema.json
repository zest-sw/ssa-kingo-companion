{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cse-notices.schema.json",
  "title": "소프트웨어학과 공지 기회 데이터 (etl/out/cse-notices.json)",
  "description": "스펙 1이 쓰고 스펙 2(전체 기회 탭)가 읽는 계약. 본문 문장은 담지 않는다. 검증 도구를 새로 들이지 않으므로 같은 규칙을 vitest 검사가 직접 확인한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "collectedAt", "since", "opportunities", "review"],
  "properties": {
    "source": { "const": "https://cse.skku.edu/cse/notice.do" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "since": { "$ref": "#/$defs/date", "description": "기준일(그날 포함)" },
    "opportunities": {
      "type": "array",
      "description": "글 번호 큰 순",
      "items": { "$ref": "#/$defs/opportunity" }
    },
    "review": {
      "type": "array",
      "description": "확인 필요. 글 번호 큰 순",
      "items": { "$ref": "#/$defs/reviewItem" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "id": { "type": "string", "pattern": "^cse:\\d+$" },
    "url": { "type": "string", "pattern": "^https://cse\\.skku\\.edu/cse/notice\\.do\\?mode=view&articleNo=\\d+$" },
    "kind": {
      "enum": ["job", "lecture", "hackathon", "contest", "edu", "club", "volunteer", "mentoring", "global", "scholarship", "course"]
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "postedAt", "host", "kind", "deadline", "rule", "deadlineRule"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "postedAt": { "$ref": "#/$defs/date" },
        "host": { "type": ["string", "null"], "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "deadline": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "rule": { "type": "string", "pattern": "^(제목|게시판|LLM): .+$" },
        "deadlineRule": {
          "anyOf": [
            { "type": "string", "pattern": "^(본문: .+|본문·제목|제목|행사 날: (제목|본문))$" },
            { "type": "null" }
          ]
        }
      },
      "if": { "properties": { "deadline": { "type": "null" } } },
      "then": { "properties": { "deadlineRule": { "type": "null" } } },
      "else": { "properties": { "deadlineRule": { "type": "string" } } }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "postedAt", "why"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "postedAt": { "$ref": "#/$defs/date" },
        "why": { "type": "string", "minLength": 1 }
      }
    }
  }
}
